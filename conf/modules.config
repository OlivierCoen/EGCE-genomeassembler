/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'FASTQC_RAW'  {
        ext.prefix = { "${meta.id}_raw" }
        publishDir = [
            path: { "${params.outdir}/qc/long_reads/fastqc/raw" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTQC_PREPROCESSED_READS' {
        ext.prefix = { "${meta.id}_preprocessed" }
        publishDir = [
            path: { "${params.outdir}/qc/long_reads/fastqc/preprocessed" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HIC_SHORT_READS_FASTQC_RAW' {
        ext.prefix = { "${meta.id}_hic_short_reads_raw" }
    }

    withName: 'HIC_SHORT_READS_FASTQC_PREPARED_READS' {
        ext.prefix = { "${meta.id}_hic_short_reads_preproces" }
    }

    withName: 'MERYL_PRINT' {
        ext.args = {
            [
                "greater-than",
                "distinct=0.9998"
            ].join(" ").trim()
        }
    }

    withName: 'HIFIASM' {
        ext.args = {
            [
                "-l0"
            ].join(" ").trim()
        }
        publishDir = [
            path: { "${params.outdir}/assemblies/draft" },
            mode: params.publish_dir_mode,
        ]
    }

     withName: 'FLYE' {
        ext.args = {
            [
                "--debug"
            ].join(" ").trim()
        }
        publishDir = [
            path: { "${params.outdir}/assemblies/draft" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MAP_LONG_READS_TO_ASSEMBLY_MINIMAP2:MINIMAP2_ALIGN' {
        ext.prefix = { "${reads.simpleName}_mapped_to_${reference.simpleName}" }
        tag = { "${meta.id} :: ${reads.simpleName} mapped to ${reference.simpleName}" }
    }

    withName: 'SAMTOOLS_STATS' {
        tag = { "${meta.id} :: ${input.simpleName} on assembly ${fasta.simpleName}" }
    }

    withName: 'SAMTOOLS_FLAGSTAT' {
        tag = { "${meta.id} :: ${bam.simpleName}" }
    }

    withName: 'SAMTOOLS_IDXSTATS' {
        tag = { "${meta.id} :: ${bam.simpleName}" }
    }

    withName: 'CLAIR3' {
        ext.args = {
            [
                "--remove_intermediate_dir",

            ].join(" ").trim()
        }
    }

    withName: 'FASTP' {
        ext.args = {
            [
                "--average_qual", "5"
            ].join(" ").trim()
        }
        publishDir = [
            path: { "${params.outdir}/preprocessing/hic_short_reads" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'FASTPLONG' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/long_reads" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'LONGPHASE_PHASE' {
        ext.args = {
            [
                "--mappingQuality 1",
                "--indels"
            ].join(" ").trim()
        }
    }

    withName: 'PURGEDUPS_HISTPLOT' {
        publishDir = [
            path: { "${params.outdir}/qc/purgedups_histplot" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PURGEDUPS_GETSEQS' {
        publishDir = [
            path: { "${params.outdir}/assemblies/purged" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'JUICERTOOLS_PRE' {
        publishDir = [
            path: { "${params.outdir}/hic/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MEDAKA' {
        // errors may happen with conda
        //errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/assemblies/polished" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'PICARD_ADDORREPLACEREADGROUPS' {
        ext.args = {
            [
                "--RGID ${meta.id}",
                "--RGLB ${meta.id}",
                "--RGPL Illumina",
                "--RGPU ${meta.id}",
                "--RGSM ${meta.id}"
            ].join(" ").trim()
        }
    }

    withName: 'PICARD_MARKDUPLICATES' {
        ext.prefix = { "${meta.id}.marked" }
        ext.args = {
            [
                "--ASSUME_SORTED TRUE",
                "--VALIDATION_STRINGENCY LENIENT",
                "--REMOVE_DUPLICATES TRUE"
            ].join(" ").trim()
        }
    }

}

withName: 'YAHS' {
   ext.args = {
       [
           "-R 10"
       ].join(" ").trim()
   }
   publishDir = [
       path: { "${params.outdir}/assemblies/scaffolded" },
       mode: params.publish_dir_mode
   ]
}

includeConfig 'modules/qc.config'
